# Copy to .env and adjust.
NODE_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgres://prepledger:prepledger@localhost:5432/prepledger
# 32+ random chars; used to sign nothing secret today but required for future cookie signing
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# Public origin used for canonical URLs
PUBLIC_ORIGIN=http://localhost:4000
# Initial admin created by `npm run seed` (change the password immediately)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Optional: path to a Chromium binary for server-side PDF export
CHROMIUM_PATH=
LOG_LEVEL=info
